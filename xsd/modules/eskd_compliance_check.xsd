<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  МОДУЛЬ ПРОВЕРКИ СООТВЕТСТВИЯ ИЗДЕЛИЯ РАЗРЕШЁННОМУ ПЕРЕЧНЮ
  ============================================================================
  Основано на:
  - ГОСТ 2.053-2023 (ЕСКД. Электронная структура изделия)
  - ГОСТ 2.111-2013 (ЕСКД. Нормоконтроль)
  - ГОСТ Р 77.403 (Профили интероперабельности)
  
  Этот модуль расширяет профиль интероперабельности ЭКБ/РЭА следующими возможностями:
  - Поэлементная проверка соответствия компонентов разрешённому перечню
  - Статусы проверки по каждой позиции спецификации
  - Отчёт о проверке с детализацией до уровня компонента
  - Ссылки на нормоконтролёра и верификатора
  
  Требования ГОСТ 2.053-2023:
  - Пункт 5.2.4: Электронная структура изделия должна содержать данные о составе
  - Пункт 6.1.3: Должна обеспечиваться проверка состава на соответствие требованиям
  - Пункт 7.2.1: Данные о проверке должны быть связаны с позициями спецификации
  
  Требования ГОСТ 2.111-2013:
  - Пункт 4.2.5: Нормоконтроль включает проверку применения покупных изделий
  - Пункт 5.1.2: Должна быть зафиксирована ссылка на нормоконтролёра
  - Пункт 6.3: Результаты нормоконтроля документируются с указанием замечаний
  
  Область применения:
  - Автоматизированная проверка соответствия изделия разрешённому перечню ЭКБ/РЭА
  - Фиксация результатов поэлементной проверки с детализацией статусов
  - Обмен отчётами о проверке между системами управления данными об изделии
  - Поддержка процессов нормоконтроля при выпуске конструкторской документации
  ============================================================================
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:eskd-core="http://gost.ru/eskd/core/2024"
           xmlns:eskd-bind="http://gost.ru/eskd/binding/2024"
           xmlns:eskd-ekb="http://gost.ru/eskd/profile/ekb/2024"
           xmlns:eskd-dc="http://gost.ru/eskd/docclass/2024"
           xmlns:eskd-cc="http://gost.ru/eskd/compliance/2024"
           targetNamespace="http://gost.ru/eskd/compliance/2024"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified"
           version="1.0"
           xml:lang="ru"
           xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning"
           vc:minVersion="1.1">

  <xs:import namespace="http://gost.ru/eskd/core/2024"
             schemaLocation="../core/eskd_core.xsd"/>
  <xs:import namespace="http://gost.ru/eskd/binding/2024"
             schemaLocation="../binding/eskd_binding.xsd"/>
  <xs:import namespace="http://gost.ru/eskd/profile/ekb/2024"
             schemaLocation="../profile/eskd_profile_ekb.xsd"/>
  <xs:import namespace="http://gost.ru/eskd/docclass/2024"
             schemaLocation="eskd_document_classification.xsd"/>
  <xs:import namespace="http://gost.ru/eskd/profile/ekb/2024"
             schemaLocation="../profile/eskd_profile_ekb.xsd"/>

  <xs:annotation>
    <xs:documentation>
      МОДУЛЬ ПРОВЕРКИ СООТВЕТСТВИЯ (COMPLIANCE CHECK).
      
      Содержит:
      - ComplianceCheckType: проверка одной позиции спецификации
      - ComplianceReportType: отчёт о проверке всего изделия
      - Элемент compliance_report для обмена отчётами
      
      Пространство имён: http://gost.ru/eskd/compliance/2024
      Префикс: eskd-cc
      
      Этот модуль НЕ заменяет существующий ComplianceAssertionType из 
      eskd_profile_ekb.xsd, а предоставляет более детальную функциональность
      для поэлементной проверки.
    </xs:documentation>
  </xs:annotation>

  <!-- ========================================================================
       РАЗДЕЛ 1: ПРОСТЫЕ ТИПЫ (СТАТУСЫ ПРОВЕРКИ)
       ======================================================================== -->

  <xs:simpleType name="CheckStatusEnum">
    <xs:annotation>
      <xs:documentation>
        Статус проверки отдельной позиции спецификации.
        
        Согласно ГОСТ 2.111-2013 (пункт 4.2.5):
        - passed: компонент соответствует разрешённому перечню
        - failed: компонент не соответствует (требуется замена или согласование)
        - warning: условное соответствие (требует дополнительной проверки)
        
        Значения:
        - passed: Соответствует — компонент найден в разрешённом перечне, 
                  все параметры совпадают, ограничений применения нет
        - failed: Не соответствует — компонент отсутствует в перечне или 
                  имеет статус prohibited/restricted для данного применения
        - warning: Требует проверки — компонент присутствует в перечне, но 
                   имеет ограничения (conditionally approved, deprecated) или 
                   требует уточнения области применения
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="passed">
        <xs:annotation>
          <xs:documentation>
            Соответствует — позиция успешно прошла проверку.
            Компонент присутствует в разрешённом перечне со статусом approved
            или conditionally без ограничений для данного изделия.
          </xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="failed">
        <xs:annotation>
          <xs:documentation>
            Не соответствует — позиция не прошла проверку.
            Компонент отсутствует в разрешённом перечне или имеет статус 
            prohibited/restricted для данного применения. Требуется замена 
            или процедура согласования по ГОСТ 2.124-2014.
          </xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="warning">
        <xs:annotation>
          <xs:documentation>
            Требует проверки — позиция прошла проверку с предупреждениями.
            Компонент присутствует в перечне, но:
            - Имеет статус deprecated (не рекомендуется к новому применению)
            - Имеет ограничения по области применения
            - Требует уточнения условий эксплуатации
            - Является условно разрешённым (conditionally approved)
          </xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="OverallComplianceStatusEnum">
    <xs:annotation>
      <xs:documentation>
        Итоговый статус проверки всего изделия.
        
        Согласно ГОСТ 2.053-2023 (пункт 7.2.1) и ГОСТ 2.111-2013 (пункт 6.3):
        - full_compliance: все компоненты соответствуют разрешённому перечню
        - partial_compliance: часть компонентов требует замены или согласования
        - non_compliant: критическое количество несоответствий
        - not_verified: проверка не была выполнена
        
        Используется в ComplianceReportType для общей оценки соответствия.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="full_compliance">
        <xs:annotation>
          <xs:documentation>
            Полное соответствие — все позиции спецификации имеют статус passed.
            Изделие полностью соответствует разрешённому перечню ЭКБ/РЭА.
            Допускается к производству без дополнительных согласований.
          </xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="partial_compliance">
        <xs:annotation>
          <xs:documentation>
            Частичное соответствие — имеются позиции со статусом warning 
            или единичные failed (некритичные компоненты).
            Требуется анализ замечаний и, при необходимости, согласование
            замен по ГОСТ 2.124-2014.
          </xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="non_compliant">
        <xs:annotation>
          <xs:documentation>
            Не соответствует — критическое количество позиций со статусом failed.
            Изделие не может быть принято к производству без существенных 
            изменений в составе ЭКБ/РЭА. Требуется переработка конструкторской 
            документации и повторная проверка.
          </xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="not_verified">
        <xs:annotation>
          <xs:documentation>
            Не проверено — проверка не была выполнена или прервана.
            Статус присваивается при отсутствии данных о проверке или 
            при ошибке в процессе автоматизированной проверки.
          </xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <!-- ========================================================================
       РАЗДЕЛ 2: ПРОВЕРКА ОДНОЙ ПОЗИЦИИ (COMPLIANCE CHECK)
       ======================================================================== -->

  <xs:complexType name="ComplianceCheckType">
    <xs:annotation>
      <xs:documentation>
        Проверка соответствия для одной позиции спецификации изделия.
        
        Согласно ГОСТ 2.053-2023 (пункт 5.2.4) и ГОСТ 2.111-2013 (пункт 4.2.5):
        - componentRef: ссылка на компонент в электронной структуре изделия
        - allowedItemRef: ссылка на позицию в разрешённом перечне
        - status: результат проверки (passed/failed/warning)
        - comment: пояснение результата проверки
        - normControlRef: ссылка на нормоконтролёра (опционально)
        
        Используется как повторяющийся элемент в ComplianceReportType
        для детальной проверки каждой позиции спецификации.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="componentRef" type="xs:IDREF" minOccurs="1" maxOccurs="1">
        <xs:annotation>
          <xs:documentation>
            Ссылка на компонент в спецификации изделия (обязательно).
            
            Ссылается на:
            - eskd_product из ГОСТ Р 2.525-2024 (электронная структура изделия)
            - ekb_component из профиля ЭКБ/РЭА
            - другой объект, представляющий компонент в составе изделия
            
            Пример: "#12345" — идентификатор компонента в структуре изделия.
            
            Согласно ГОСТ 2.053-2023 (пункт 6.1.3), каждый компонент в 
            электронной структуре должен иметь уникальный идентификатор,
            на который возможна ссылка из отчёта о проверке.
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="allowedItemRef" type="xs:IDREF" minOccurs="0" maxOccurs="1">
        <xs:annotation>
          <xs:documentation>
            Ссылка на позицию разрешённого перечня (опционально).
            
            Ссылается на:
            - allowed_component_item из eskd_profile_ekb.xsd
            
            Отсутствует (minOccurs="0") если:
            - Компонент не найден в разрешённом перечне (status = failed)
            - Компонент является стандартным изделием общего применения
            - Компонент не требует проверки по разрешённому перечню
            
            При наличии ссылки обеспечивает трассируемость между 
            компонентом изделия и позицией в разрешённом перечне.
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="status" type="eskd-cc:CheckStatusEnum" minOccurs="1" maxOccurs="1">
        <xs:annotation>
          <xs:documentation>
            Результат проверки позиции (обязательно).
            
            Значения:
            - passed: компонент соответствует разрешённому перечню
            - failed: компонент не соответствует (требуется замена)
            - warning: компонент требует дополнительной проверки
            
            Согласно ГОСТ 2.111-2013 (пункт 5.1.2), результат нормоконтроля
            должен быть явно указан для каждой проверяемой позиции.
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="comment" type="eskd-core:LongText" minOccurs="0" maxOccurs="1">
        <xs:annotation>
          <xs:documentation>
            Пояснение к результату проверки (опционально).
            
            Содержит:
            - Для status=passed: подтверждение соответствия, номер позиции в перечне
            - Для status=failed: причина несоответствия, рекомендации по замене
            - Для status=warning: описание ограничений, требования к уточнению
            
            Согласно ГОСТ 2.111-2013 (пункт 6.3), замечания нормоконтроля
            должны быть сформулированы однозначно с указанием требований,
            которые не выполнены.
            
            Примеры:
            - "Конденсатор К10-17В соответствует ПЛ-ЭКБ-2024-001, поз. 45"
            - "Микросхема AD8421 отсутствует в разрешённом перечне. 
               Рекомендуется замена на отечественный аналог К140УД12"
            - "Резистор С2-33Н имеет статус deprecated. 
               Требуется согласование применения или замена на С2-33НМ"
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="normControlRef" type="xs:IDREF" minOccurs="0" maxOccurs="1">
        <xs:annotation>
          <xs:documentation>
            Ссылка на нормоконтролёра, выполнившего проверку (опционально).
            
            Ссылается на:
            - person из ГОСТ Р 2.058-2023 (реквизитная часть КД)
            - organization из ГОСТ Р 2.058-2023 (если проверку выполняла организация)
            
            Согласно ГОСТ 2.111-2013 (пункт 5.1.2), должен быть указан 
            исполнитель нормоконтроля для обеспечения ответственности 
            за результаты проверки.
            
            Если элемент отсутствует, считается, что проверка выполнена 
            автоматизированной системой без участия конкретного лица.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- ========================================================================
       РАЗДЕЛ 3: ОТЧЁТ О ПРОВЕРКЕ (COMPLIANCE REPORT)
       ======================================================================== -->

  <xs:complexType name="ComplianceReportType">
    <xs:annotation>
      <xs:documentation>
        Отчёт о проверке соответствия всего изделия разрешённому перечню.
        
        Согласно ГОСТ 2.053-2023 (пункт 7.2.1) и ГОСТ 2.111-2013 (пункт 6.3):
        - reportId: уникальный идентификатор отчёта
        - productRef: ссылка на проверяемое изделие
        - allowedListRef: ссылка на разрешённый перечень
        - verificationDate: дата выполнения проверки
        - overallStatus: итоговый статус проверки
        - checks: последовательность проверок по каждой позиции
        - verifier: ссылка на организацию/лицо, выполнившее проверку
        - remarks: общие замечания по результатам проверки
        
        Наследует от eskd-core:BaseEntityType для совместимости с 
        другими объектами профиля интероперабельности.
        
        Отчёт может быть использован:
        - Как приложение к конструкторским документам
        - Как входные данные для системы управления жизненным циклом
        - Как доказательство соответствия при сертификации
      </xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="eskd-core:BaseEntityType">
        <xs:sequence>
          <xs:element name="reportId" type="eskd-core:CodeString" minOccurs="1" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>
                Идентификатор отчёта о проверке (обязательно).
                
                Уникальный код отчёта в системе учёта документов.
                Примеры:
                - "ОП-2024-001" (Отчёт о Проверке)
                - "НК-АБВГ.123456.001-2024" (Нормоконтроль)
                - "CC-REP-20240115-001" (Compliance Check Report)
                
                Формат определяется организацией-разработчиком.
                Должен обеспечивать уникальность в пределах системы.
              </xs:documentation>
            </xs:annotation>
          </xs:element>

          <xs:element name="productRef" type="xs:IDREF" minOccurs="1" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>
                Ссылка на проверяемое изделие (обязательно).
                
                Ссылается на:
                - eskd_product из ГОСТ Р 2.525-2024
                - ИЛИ на документ типа "Электронная конструктивная структура" (ЭСК)
                  из ГОСТ 2.102-2023
                
                Изделие, состав ЭКБ/РЭА которого проверяется на 
                соответствие разрешённому перечню.
                
                Согласно ГОСТ 2.053-2023 (пункт 5.1), продукт является 
                корневым объектом электронной структуры изделия.
                
                Согласно ГОСТ 2.102-2023 (пункт 5.2.1.1), электронная 
                конструктивная структура (ЭСК) может выполнять функцию 
                основного конструкторского документа наравне со спецификацией.
                Поэтому productRef может ссылаться как на продукт в смысле 
                2.525, так и на документ ЭСК.
              </xs:documentation>
            </xs:annotation>
          </xs:element>

          <xs:element name="allowedListRef" type="xs:IDREF" minOccurs="1" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>
                Ссылка на разрешённый перечень (обязательно).
                
                Ссылается на:
                - allowed_component_list из eskd_profile_ekb.xsd
                
                Перечень ЭКБ/РЭА, по которому выполняется проверка.
                Должен быть утверждён и действовать на дату проверки.
                
                Примечание: одно изделие может проверяться по нескольким 
                перечням (например, по перечню предприятия и по отраслевому 
                перечню). В этом случае создаётся несколько отчётов или 
                используются расширения схемы.
              </xs:documentation>
            </xs:annotation>
          </xs:element>

          <xs:element name="verificationDate" type="eskd-core:DateType" minOccurs="1" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>
                Дата выполнения проверки (обязательно).
                
                Формат: ГГГГ-ММ-ДД согласно ГОСТ 2.304.
                
                Дата, когда была выполнена проверка соответствия.
                Для автоматизированной проверки — дата запуска скрипта/сервиса.
                Для ручной проверки — дата подписания отчёта нормоконтролёром.
                
                Согласно ГОСТ 2.111-2013 (пункт 6.3), дата проверки 
                должна быть зафиксирована в отчётных документах.
              </xs:documentation>
            </xs:annotation>
          </xs:element>

          <xs:element name="overallStatus" type="eskd-cc:OverallComplianceStatusEnum" minOccurs="1" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>
                Итоговый статус проверки изделия (обязательно).
                
                Определяется по результатам всех поэлементных проверок:
                - full_compliance: все позиции имеют статус passed
                - partial_compliance: имеются позиции со статусом warning 
                  или единичные failed (некритичные)
                - non_compliant: критическое количество failed
                - not_verified: проверка не выполнена
                
                Критерии отнесения к категориям определяются 
                организацией-разработчиком в зависимости от:
                - Количества несоответствующих позиций
                - Критичности компонентов (criticality)
                - Области применения изделия
                
                Согласно ГОСТ 2.053-2023 (пункт 7.2.1), итоговая оценка 
                соответствия должна быть явно указана в отчёте.
              </xs:documentation>
            </xs:annotation>
          </xs:element>

          <xs:element name="checks" minOccurs="1" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>
                Последовательность проверок по каждой позиции (обязательно).
                
                Содержит один или более элементов ComplianceCheckType.
                Каждый элемент описывает результат проверки одного компонента.
                
                Согласно ГОСТ 2.053-2023 (пункт 5.2.4), электронная структура 
                изделия должна поддерживать детализацию до уровня отдельных 
                компонентов. Данный элемент обеспечивает такую детализацию 
                для результатов проверки.
                
                Минимальное количество элементов: 1 (minOccurs="1").
                Пустой отчёт без проверок не допускается.
              </xs:documentation>
            </xs:annotation>
            <xs:complexType>
              <xs:sequence>
                <xs:element name="check" type="eskd-cc:ComplianceCheckType" 
                           minOccurs="1" maxOccurs="unbounded">
                  <xs:annotation>
                    <xs:documentation>
                      Проверка одной позиции спецификации.
                      Повторяющийся элемент для каждого компонента изделия.
                    </xs:documentation>
                  </xs:annotation>
                </xs:element>
              </xs:sequence>
            </xs:complexType>
          </xs:element>

          <xs:element name="verifier" type="xs:IDREF" minOccurs="0" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>
                Ссылка на организацию или лицо, выполнившее проверку (опционально).
                
                Ссылается на:
                - organization из ГОСТ Р 2.058-2023 (если проверку выполняла организация)
                - person из ГОСТ Р 2.058-2023 (если проверку выполняло конкретное лицо)
                
                Согласно ГОСТ 2.111-2013 (пункт 5.1.2), должно быть указано 
                лицо или организация, ответственные за выполнение нормоконтроля.
                
                Если элемент отсутствует, считается, что проверка выполнена 
                автоматизированной системой без явного указания исполнителя.
              </xs:documentation>
            </xs:annotation>
          </xs:element>

          <xs:element name="remarks" type="eskd-core:LongText" minOccurs="0" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>
                Общие замечания по результатам проверки (опционально).
                
                Содержит:
                - Summary-анализ результатов проверки
                - Рекомендации по устранению несоответствий
                - Ссылки на дополнительные документы
                - Условия и ограничения применения отчёта
                - Инструкции по дальнейшим действиям
                
                Согласно ГОСТ 2.111-2013 (пункт 6.3), общие замечания 
                нормоконтроля должны включать выводы и рекомендации 
                по устранению выявленных несоответствий.
                
                Пример:
                "Из 156 проверенных компонентов:
                 - 142 соответствуют разрешённому перечню (91%)
                 - 10 требуют замены (статус failed)
                 - 4 имеют ограничения применения (статус warning)
                 
                 Критичные несоответствия отсутствуют.
                 Рекомендуется выполнить замену компонентов до начала 
                 производства опытного образца.
                 
                 Срок устранения замечаний: до 2024-03-01"
              </xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!-- ========================================================================
       РАЗДЕЛ 4: КОРНЕВОЙ ЭЛЕМЕНТ ДЛЯ ОБМЕНА ОТЧЁТАМИ
       ======================================================================== -->

  <xs:element name="compliance_report" type="eskd-cc:ComplianceReportType">
    <xs:annotation>
      <xs:documentation>
        Корневой элемент для обмена отчётами о проверке соответствия.
        
        Предназначен для:
        - Экспорта отчётов из системы управления данными об изделии
        - Импорта отчётов в другие системы (PLM, ERP, MES)
        - Архивирования результатов нормоконтроля
        - Приложения к конструкторским документам
        
        Этот элемент НЕ заменяет existing compliance_assertion из 
        eskd_profile_ekb.xsd, а предоставляет альтернативный формат 
        с детальной поэлементной проверкой.
        
        Пример использования:
        &lt;eskd-cc:compliance_report id="CR-2024-001"&gt;
          &lt;reportId&gt;НК-АБВГ.123456.001-2024&lt;/reportId&gt;
          &lt;productRef ref="#PROD-001"/&gt;
          &lt;allowedListRef ref="#LIST-001"/&gt;
          &lt;verificationDate&gt;2024-01-15&lt;/verificationDate&gt;
          &lt;overallStatus&gt;partial_compliance&lt;/overallStatus&gt;
          &lt;checks&gt;
            &lt;check&gt;...&lt;/check&gt;
            &lt;check&gt;...&lt;/check&gt;
          &lt;/checks&gt;
          &lt;remarks&gt;...&lt;/remarks&gt;
        &lt;/eskd-cc:compliance_report&gt;
      </xs:documentation>
    </xs:annotation>
  </xs:element>

  <!-- ========================================================================
       РАЗДЕЛ 5: ИНСТРУКЦИЯ ПО ПОДКЛЮЧЕНИЮ К ПРОФИЛЮ
       ======================================================================== -->
  
  <xs:annotation>
    <xs:documentation>
      ============================================================================
      ИНСТРУКЦИЯ ПО ПОДКЛЮЧЕНИЮ К ESKD_PROFILE_EKB.XSD
      ============================================================================
      
      Данный модуль является самостоятельным и НЕ требует модификации 
      eskd_profile_ekb.xsd для базовой функциональности.
      
      Вариант 1: Использование как отдельного корневого элемента
      ---------------------------------------------------------
      Модуль уже содержит корневой элемент compliance_report.
      Для генерации/валидации отчётов достаточно:
      
      1. Убедиться, что все необходимые модули доступны:
         - eskd_core.xsd
         - eskd_binding.xsd
         - eskd_profile_ekb.xsd
      
      2. Создать XML-документ с пространством имён eskd-cc:
         &lt;?xml version="1.0" encoding="UTF-8"?&gt;
         &lt;eskd-cc:compliance_report 
             xmlns:eskd-cc="http://gost.ru/eskd/compliance/2024"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://gost.ru/eskd/compliance/2024 eskd_compliance_check.xsd"&gt;
           ...
         &lt;/eskd-cc:compliance_report&gt;
      
      3. Валидировать документ против eskd_compliance_check.xsd
      
      
      Вариант 2: Интеграция в основной профиль (опционально)
      ------------------------------------------------------
      Для удобства можно добавить импорт в eskd_profile_ekb.xsd:
      
      1. Добавьте import в начало eskd_profile_ekb.xsd:
         &lt;xs:import namespace="http://gost.ru/eskd/compliance/2024"
                    schemaLocation="modules/eskd_compliance_check.xsd"/&gt;
      
      2. Добавьте объявление xmlns в xs:schema:
         xmlns:eskd-cc="http://gost.ru/eskd/compliance/2024"
      
      3. После этого элементы eskd-cc будут доступны в документах, 
         использующих профиль eskd_profile_ekb.xsd
      
      
      Обратная совместимость
      ----------------------
      - Все новые элементы являются опциональными в контексте существующего профиля
      - Существующий ComplianceAssertionType НЕ изменён и продолжает работать
      - compliance_report является дополнением, а не заменой compliance_assertion
      - Документы, созданные до добавления модуля, остаются валидными
      
      
      Связь с другими модулями
      ------------------------
      - eskd_core.xsd: базовые типы (CodeString, DateType, LongText, BaseEntityType)
      - eskd_binding.xsd: связи с продуктами (Binding_ProductKey)
      - eskd_profile_ekb.xsd: AllowedComponentListType, AllowedComponentItemType
      - ГОСТ Р 2.525-2024: eskd_product (через IDREF)
      - ГОСТ Р 2.058-2023: person, organization (через IDREF)
      - ГОСТ 2.111-2013: нормоконтроль (семантика проверки)
      - ГОСТ 2.053-2023: электронная структура изделия (детализация компонентов)
      ============================================================================
    </xs:documentation>
  </xs:annotation>

</xs:schema>
