<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:eskd-core="http://gost.ru/eskd/core/2024"
           xmlns:eskd-2058="http://gost.ru/eskd/2.058/2023"
           targetNamespace="http://gost.ru/eskd/2.058/2023"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified"
           version="0.2"
           xml:lang="ru"
           xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning"
           vc:minVersion="1.1">

  <xs:import namespace="http://gost.ru/eskd/core/2024"
             schemaLocation="../core/eskd_core.xsd"/>

  <xs:annotation>
    <xs:documentation>
      ============================================================================
      МОДУЛЬ РЕКВИЗИТОВ ДОКУМЕНТОВ (ГОСТ Р 2.058-2023)
      ============================================================================
      Основано на:
      - ГОСТ Р 2.058-2023 (Реквизитная часть электронных конструкторских документов)
      - ГОСТ Р 2.104 (Основные надписи)
      - ГОСТ Р 2.051 (Электронные документы)
      - ГОСТ Р 77.302 (Общие данные об изделии)
      
      Этот модуль описывает реквизитную часть КД:
      - Реквизиты документов (designator, title, legal_owner)
      - Версии и изменения (version, revision, directive_ref)
      - Действия с КД (doc_handling, handling_person, person_signature)
      - Состояния КД (status, status_type, status_date)
      - Применяемость (applicability, litera, restriction)
      - Организации и лица
      ============================================================================
    </xs:documentation>
  </xs:annotation>

  <!-- ========================================================================
       РАЗДЕЛ 1: ПРОСТЫЕ ТИПЫ (СПЕЦИФИЧНЫЕ ДЛЯ 2.058)
       ======================================================================== -->

  <xs:simpleType name="DocHandlingTypeEnum">
    <xs:annotation>
      <xs:documentation>
        Тип действия с документом (ГОСТ Р 2.058-2023, табл. 1).
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="DEVELOPMENT">
        <xs:annotation><xs:documentation>Разработка</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="REVISION">
        <xs:annotation><xs:documentation>Пересмотр</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="APPROVAL">
        <xs:annotation><xs:documentation>Согласование</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RELEASE">
        <xs:annotation><xs:documentation>Выпуск</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CANCEL">
        <xs:annotation><xs:documentation>Аннулирование</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RESTORE">
        <xs:annotation><xs:documentation>Восстановление</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TRANSFER">
        <xs:annotation><xs:documentation>Передача</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DESTRUCTION">
        <xs:annotation><xs:documentation>Уничтожение</xs:documentation></xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="SignatureTypeEnum">
    <xs:annotation>
      <xs:documentation>
        Тип подписи (ГОСТ Р 2.058-2023).
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="ORIGINAL">
        <xs:annotation><xs:documentation>Подлинник</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="COPY">
        <xs:annotation><xs:documentation>Копия</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ELECTRONIC">
        <xs:annotation><xs:documentation>Электронная подпись</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ENHANCED_ELECTRONIC">
        <xs:annotation><xs:documentation>Усиленная электронная подпись</xs:documentation></xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="StatusTypeEnum">
    <xs:annotation>
      <xs:documentation>
        Тип состояния документа (ГОСТ Р 2.058-2023, табл. 4).
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="DRAFT">
        <xs:annotation><xs:documentation>Черновик</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="IN_REVIEW">
        <xs:annotation><xs:documentation>На согласовании</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="APPROVED">
        <xs:annotation><xs:documentation>Утвержден</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RELEASED">
        <xs:annotation><xs:documentation>Выпущен</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="OBSOLETE">
        <xs:annotation><xs:documentation>Устарел</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CANCELLED">
        <xs:annotation><xs:documentation>Аннулирован</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ARCHIVED">
        <xs:annotation><xs:documentation>Архивирован</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="REPLACED">
        <xs:annotation><xs:documentation>Заменен</xs:documentation></xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="LiteraEnum">
    <xs:annotation>
      <xs:documentation>
        Литера стадии разработки (ГОСТ 2.103).
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="A">
        <xs:annotation><xs:documentation>Стадия А (Техническое предложение)</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="B">
        <xs:annotation><xs:documentation>Стадия Б (Эскизный проект)</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="C">
        <xs:annotation><xs:documentation>Стадия В (Технический проект)</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="D">
        <xs:annotation><xs:documentation>Стадия Г (Рабочая документация)</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="E">
        <xs:annotation><xs:documentation>Стадия Д (Опытный образец)</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="I">
        <xs:annotation><xs:documentation>Стадия И (Серийное производство)</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="O">
        <xs:annotation><xs:documentation>Стадия О (Массовое производство)</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="P">
        <xs:annotation><xs:documentation>Стадия П (Ремонт)</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="T">
        <xs:annotation><xs:documentation>Стадия Т (Утилизация)</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="X">
        <xs:annotation><xs:documentation>Стадия Х (Прочее)</xs:documentation></xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="DirectiveTypeEnum">
    <xs:annotation>
      <xs:documentation>
        Тип распорядительного документа (ГОСТ Р 2.058-2023).
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="ORDER">
        <xs:annotation><xs:documentation>Приказ</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DIRECTIVE">
        <xs:annotation><xs:documentation>Распоряжение</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DECISION">
        <xs:annotation><xs:documentation>Решение</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PROTOCOL">
        <xs:annotation><xs:documentation>Протокол</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="OTHER">
        <xs:annotation><xs:documentation>Другой тип</xs:documentation></xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ApplicabilityTypeEnum">
    <xs:annotation>
      <xs:documentation>
        Тип применяемости (ГОСТ Р 2.058-2023).
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="SERIAL">
        <xs:annotation><xs:documentation>Серийное применение</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="EXPERIMENTAL">
        <xs:annotation><xs:documentation>Опытное применение</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SINGLE">
        <xs:annotation><xs:documentation>Единичное применение</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="REPAIR">
        <xs:annotation><xs:documentation>Ремонтное применение</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MODERNIZATION">
        <xs:annotation><xs:documentation>Модернизация</xs:documentation></xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="DocFormEnum">
    <xs:annotation>
      <xs:documentation>
        Форма представления исходного КД (ГОСТ Р 2.058-2023, п. 12.3).
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="ELECTRONIC">
        <xs:annotation><xs:documentation>Электронная форма</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PAPER">
        <xs:annotation><xs:documentation>Бумажная форма</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BOTH">
        <xs:annotation><xs:documentation>Обе формы</xs:documentation></xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ProjectionMethodEnum">
    <xs:annotation>
      <xs:documentation>
        Метод проецирования (ГОСТ Р 2.058-2023, п. 16.6).
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="FIRST_ANGLE">
        <xs:annotation><xs:documentation>Метод первого угла</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="THIRD_ANGLE">
        <xs:annotation><xs:documentation>Метод третьего угла</xs:documentation></xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <!-- ========================================================================
       РАЗДЕЛ 2: РЕКВИЗИТЫ ДОКУМЕНТА (DOC_REQUISITE)
       ======================================================================== -->

  <xs:complexType name="doc_requisiteType">
    <xs:annotation>
      <xs:documentation>
        Реквизитная часть конструкторского документа.
        Наследует от eskd-core:BaseDocumentType.
        ГОСТ Р 2.058-2023, табл. 1.
      </xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="eskd-core:BaseDocumentType">
        <xs:sequence>
          <xs:element name="designator" type="eskd-core:Designator" minOccurs="1" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>
                Обозначение документа (обязательно, ГОСТ 2.201).
              </xs:documentation>
            </xs:annotation>
          </xs:element>
          
          <xs:element name="legal_owner" type="xs:IDREF" minOccurs="1" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>
                Ссылка на организацию - владельца подлинника (обязательно).
              </xs:documentation>
            </xs:annotation>
          </xs:element>
          
          <xs:element name="creation_date" type="eskd-core:DateType" minOccurs="1" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>
                Дата разработки документа (обязательно).
              </xs:documentation>
            </xs:annotation>
          </xs:element>
          
          <xs:element name="litera" type="eskd-2058:LiteraEnum" minOccurs="0" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>
                Литера стадии разработки.
              </xs:documentation>
            </xs:annotation>
          </xs:element>
          
          <xs:element name="applicability" type="eskd-2058:ApplicabilityTypeEnum" minOccurs="0" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>
                Тип применяемости документа.
              </xs:documentation>
            </xs:annotation>
          </xs:element>
          
          <xs:element name="restriction" type="eskd-core:LongText" minOccurs="0" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>
                Ограничения на использование и распространение.
              </xs:documentation>
            </xs:annotation>
          </xs:element>
          
          <xs:element name="doc_form" type="eskd-2058:DocFormEnum" minOccurs="0" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>
                Форма представления исходного КД (ГОСТ Р 2.058-2023, п. 12.3).
              </xs:documentation>
            </xs:annotation>
          </xs:element>
          
          <xs:element name="doc_format" type="eskd-core:CodeString" minOccurs="0" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>
                Формат данных содержательной части исходного КД (п. 12.4).
              </xs:documentation>
            </xs:annotation>
          </xs:element>
          
          <xs:element name="doc_creating_system" type="eskd-core:ShortText" minOccurs="0" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>
                Автоматизированная система (включая версию), в которой разработан ДЭ (п. 12.5).
              </xs:documentation>
            </xs:annotation>
          </xs:element>
          
          <xs:element name="doc_location" type="eskd-core:MediumText" minOccurs="0" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>
                Место размещения исходного КД (АСУДИ, сервер и т. п.) (п. 12.6).
              </xs:documentation>
            </xs:annotation>
          </xs:element>
          
          <xs:element name="first_doc" type="xs:IDREF" minOccurs="0" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>
                Первичное применение (ссылка на документ) (п. 13).
              </xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:element name="doc_requisite" type="eskd-2058:doc_requisiteType">
    <xs:annotation>
      <xs:documentation>Экземпляр реквизитной части документа</xs:documentation>
    </xs:annotation>
  </xs:element>

  <!-- ========================================================================
       РАЗДЕЛ 3: ВЕРСИИ И ИЗМЕНЕНИЯ (VERSION)
       ======================================================================== -->

  <xs:complexType name="versionType">
    <xs:annotation>
      <xs:documentation>
        Версия документа (изменение).
        Наследует от eskd-core:BaseEntityType.
        ГОСТ Р 2.058-2023, табл. 2.
      </xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="eskd-core:BaseEntityType">
        <xs:sequence>
          <xs:element name="version_id" type="eskd-core:VersionString" minOccurs="1" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>
                Номер изменения или версия (обязательно).
              </xs:documentation>
            </xs:annotation>
          </xs:element>
          
          <xs:element name="doc_requisite" type="xs:IDREF" minOccurs="1" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>
                Ссылка на реквизиты документа (обязательно).
              </xs:documentation>
            </xs:annotation>
          </xs:element>
          
          <xs:element name="directive_ref" type="xs:IDREF" minOccurs="0" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>
                Ссылка на распорядительный документ об изменении.
              </xs:documentation>
            </xs:annotation>
          </xs:element>
          
          <xs:element name="change_date" type="eskd-core:DateType" minOccurs="1" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>
                Дата внесения изменения (обязательно).
              </xs:documentation>
            </xs:annotation>
          </xs:element>
          
          <xs:element name="change_reason" type="eskd-core:LongText" minOccurs="0" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>
                Причина внесения изменения.
              </xs:documentation>
            </xs:annotation>
          </xs:element>
          
          <xs:element name="change_author" type="xs:IDREF" minOccurs="0" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>
                Ссылка на лицо, внесшее изменение.
              </xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:element name="version" type="eskd-2058:versionType">
    <xs:annotation>
      <xs:documentation>Экземпляр версии документа</xs:documentation>
    </xs:annotation>
  </xs:element>

  <!-- ========================================================================
       РАЗДЕЛ 4: ДЕЙСТВИЯ С КД (DOC_HANDLING)
       ======================================================================== -->

  <xs:complexType name="doc_handlingType">
    <xs:annotation>
      <xs:documentation>
        Действие с конструкторским документом.
        Наследует от eskd-core:BaseEntityType.
        ГОСТ Р 2.058-2023, табл. 3.
      </xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="eskd-core:BaseEntityType">
        <xs:sequence>
          <xs:element name="id" type="eskd-core:CodeString" minOccurs="1" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>Идентификатор действия (обязательно)</xs:documentation>
            </xs:annotation>
          </xs:element>
          
          <xs:element name="handling_type" type="eskd-2058:DocHandlingTypeEnum" minOccurs="1" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>Тип действия с документом (обязательно)</xs:documentation>
            </xs:annotation>
          </xs:element>
          
          <xs:element name="handling_date" type="eskd-core:DateTimeType" minOccurs="1" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>Дата и время выполнения действия (обязательно)</xs:documentation>
            </xs:annotation>
          </xs:element>
          
          <xs:element name="handling_person" type="xs:IDREF" minOccurs="1" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>Ссылка на лицо, выполнившее действие (обязательно)</xs:documentation>
            </xs:annotation>
          </xs:element>
          
          <xs:element name="handling_organization" type="xs:IDREF" minOccurs="0" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>Ссылка на организацию, выполнившую действие</xs:documentation>
            </xs:annotation>
          </xs:element>
          
          <xs:element name="doc_requisite" type="xs:IDREF" minOccurs="1" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>Ссылка на реквизиты документа (обязательно)</xs:documentation>
            </xs:annotation>
          </xs:element>
          
          <xs:element name="version" type="xs:IDREF" minOccurs="0" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>Ссылка на версию документа</xs:documentation>
            </xs:annotation>
          </xs:element>
          
          <xs:element name="handling_result" type="eskd-core:MediumText" minOccurs="0" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>Результат выполнения действия</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:element name="doc_handling" type="eskd-2058:doc_handlingType">
    <xs:annotation>
      <xs:documentation>Экземпляр действия с документом</xs:documentation>
    </xs:annotation>
  </xs:element>

  <!-- ========================================================================
       РАЗДЕЛ 5: ПОДПИСИ (PERSON_SIGNATURE)
       ======================================================================== -->

  <xs:complexType name="person_signatureType">
    <xs:annotation>
      <xs:documentation>
        Подпись лица в документе.
        Наследует от eskd-core:BaseEntityType.
        ГОСТ Р 2.058-2023, табл. 5.
      </xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="eskd-core:BaseEntityType">
        <xs:sequence>
          <xs:element name="id" type="eskd-core:CodeString" minOccurs="1" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>Идентификатор подписи (обязательно)</xs:documentation>
            </xs:annotation>
          </xs:element>
          
          <xs:element name="person" type="xs:IDREF" minOccurs="1" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>Ссылка на подписавшее лицо (обязательно)</xs:documentation>
            </xs:annotation>
          </xs:element>
          
          <xs:element name="signature_type" type="eskd-2058:SignatureTypeEnum" minOccurs="1" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>Тип подписи (обязательно)</xs:documentation>
            </xs:annotation>
          </xs:element>
          
          <xs:element name="signature_date" type="eskd-core:DateTimeType" minOccurs="1" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>Дата и время подписания (обязательно)</xs:documentation>
            </xs:annotation>
          </xs:element>
          
          <xs:element name="doc_requisite" type="xs:IDREF" minOccurs="1" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>Ссылка на реквизиты документа (обязательно)</xs:documentation>
            </xs:annotation>
          </xs:element>
          
          <xs:element name="version" type="xs:IDREF" minOccurs="0" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>Ссылка на версию документа</xs:documentation>
            </xs:annotation>
          </xs:element>
          
          <xs:element name="role" type="eskd-core:ShortText" minOccurs="1" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>
                Роль подписавшего (Разработал, Проверил, Нормоконтроль и т.д.)
              </xs:documentation>
            </xs:annotation>
          </xs:element>
          
